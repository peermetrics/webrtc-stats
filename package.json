    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^22.10.0",
    "@types/webrtc": "^0.0.42",
    "babel-preset-minify": "^0.5.2",
    "http-server": "^14.1.1",
    "rollup": "^4.28.1",
